  "version": "0.2.0",
  "configurations": [
    {
      "name": "git_central",
      "request": "launch",
      "type": "dart",
      "args": ["--dart-define=API_URL=https://api.github.com"]
    },
    {
      "name": "git_central (profile mode)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "profile",
      "args": ["--dart-define=API_URL=https://api.github.com"]
    },
    {
      "name": "git_central (release mode)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "release",
      "args": ["--dart-define=API_URL=https://api.github.com"]
    }
  ]
}
